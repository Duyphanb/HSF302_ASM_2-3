# =========================================================
# AI CHATBOX - GOOGLE GEMINI
# =========================================================

# false: dùng DisabledAIChatServiceImpl
# true: gọi Google Gemini
AI_ENABLED=false

# Khi bật AI, đổi thành google-genai
SPRING_AI_MODEL_CHAT=none

# Không commit API key thật.
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng.
GEMINI_MODEL=gemini-3.1-flash-lite
