# =========================================================
# AI CHATBOX - GOOGLE GEMINI
# =========================================================

# Sao chép file này thành .env. Spring Boot sẽ tự đọc, không cần thư viện dotenv.
# Để bật AI, đặt SPRING_AI_MODEL_CHAT=google-genai và thay API key mẫu bên dưới.

# none: tắt AI
# google-genai: bật Gemini
SPRING_AI_MODEL_CHAT=none

# Không commit API key thật.
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng.
GEMINI_MODEL=gemini-3.1-flash-lite

PAYMENT_QR_BANK_BIN=your_bank_bin
PAYMENT_QR_ACCOUNT_NUMBER=your_account_number
PAYMENT_QR_ACCOUNT_NAME=YOUR ACCOUNT NAME
